                "id": {
                  "type": "string",
                  "minLength": 13
                },
                "published": {
                  "type": "string",
                  "minLength": 19
                },
                "lastModified": {
                  "type": "string"
                },
                "vulnStatus": {
                  "type": "string"
                },
                "descriptions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "value"
                    ],
                    "properties": {
                      "lang": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                },
                "metrics": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "cvssMetricV40": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/Assessment40"
                      }
                    },
                    "cvssMetricV31": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/Assessment31"
                      }
                    }
                  }
                },
                "configurations": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Configuration"
                  }
                },
                "affected": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            },
            "Assessment40": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "cvssData"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "cvssData": {
                  "allOf": [
                    {
                      "$ref": "#/definitions/BaseScore"
                    },
                    {
                      "properties": {
                        "version": {
                          "enum": [
                            "4.0"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "Assessment31": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "cvssData"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "cvssData": {
                  "allOf": [
                    {
                      "$ref": "#/definitions/BaseScore"
                    },
                    {
                      "properties": {
                        "version": {
                          "enum": [
                            "3.1"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "BaseScore": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "version",
                "baseScore",
                "baseSeverity"
              ],
              "properties": {
                "version": {
                  "type": "string"
                },
                "baseScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "baseSeverity": {
                  "type": "string",
                  "enum": [
                    "NONE",
                    "LOW",
                    "MEDIUM",
                    "HIGH",
                    "CRITICAL"
                  ]
                }
              },
              "oneOf": [
                {
                  "properties": {
                    "baseSeverity": {
                      "enum": [
                        "CRITICAL"
                      ]
                    },
                    "baseScore": {
                      "minimum": 9
                    }
                  }
                },
                {
                  "properties": {
                    "baseSeverity": {
                      "enum": [
                        "NONE",
                        "LOW",
                        "MEDIUM",
                        "HIGH"
                      ]
                    }
                  }
                }
              ]
            },
            "Configuration": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "operator": {
                  "type": "string",
                  "enum": [
                    "AND",
                    "OR"
                  ]
                },
                "negate": {
                  "type": "boolean"
                },
                "nodes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Configuration"
                  }
                },
                "children": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Configuration"
                  }
                },
                "cpeMatch": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": [
                      "vulnerable",
                      "criteria"
                    ],
                    "properties": {
                      "vulnerable": {
                        "type": "boolean"
                      },
                      "criteria": {
                        "type": "string"
                      },
                      "versionStartIncluding": {
                        "type": "string"
                      },
                      "versionStartExcluding": {
                        "type": "string"
                      },
                      "versionEndIncluding": {
                        "type": "string"
                      },
                      "versionEndExcluding": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "actions": {
    "Initialize_ReportBody": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ReportBody",
            "type": "string",
            "value": ""
